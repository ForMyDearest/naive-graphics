find_package(slang CONFIG REQUIRED)
get_target_property(_slang_includes slang::slang INTERFACE_INCLUDE_DIRECTORIES)
if (NOT _slang_includes)
    message(FATAL_ERROR "slang::slang has no INTERFACE_INCLUDE_DIRECTORIES")
endif ()
list(GET _slang_includes 0 _slang_inc)
cmake_path(GET _slang_inc PARENT_PATH _slang_prefix)

set(SLANG_RHI_BUILD_SHARED ON CACHE BOOL "Build shared library" FORCE)
set(SLANG_RHI_BUILD_TESTS OFF CACHE BOOL "Build tests" FORCE)
set(SLANG_RHI_BUILD_TESTS_WITH_GLFW OFF CACHE BOOL "Build tests that require GLFW" FORCE)
set(SLANG_RHI_BUILD_EXAMPLES OFF CACHE BOOL "Build examples" FORCE)
set(SLANG_RHI_INSTALL OFF CACHE BOOL "Install library" FORCE)

set(SLANG_RHI_ENABLE_COVERAGE OFF CACHE BOOL "Enable code coverage (clang only)" FORCE)
set(SLANG_RHI_ENABLE_ASAN OFF CACHE BOOL "Enable AddressSanitizer (clang only)" FORCE)
set(SLANG_RHI_ENABLE_UBSAN OFF CACHE BOOL "Enable UndefinedBehaviorSanitizer (clang only)" FORCE)
set(SLANG_RHI_ENABLE_TSAN OFF CACHE BOOL "Enable ThreadSanitizer (clang only)" FORCE)

set(SLANG_RHI_ENABLE_CPU OFF CACHE BOOL "Enable CPU backend" FORCE)
set(SLANG_RHI_ENABLE_D3D11 OFF CACHE BOOL "Enable D3D11 backend" FORCE)
set(SLANG_RHI_ENABLE_D3D12 OFF CACHE BOOL "Enable D3D12 backend" FORCE)
set(SLANG_RHI_ENABLE_AGILITY_SDK OFF CACHE BOOL "Enable Agility SDK" FORCE)
set(SLANG_RHI_ENABLE_NVAPI OFF CACHE BOOL "Enable NVAPI support" FORCE)
set(SLANG_RHI_ENABLE_VULKAN ON CACHE BOOL "Enable Vulkan backend" FORCE)
set(SLANG_RHI_ENABLE_METAL OFF CACHE BOOL "Enable Metal backend" FORCE)
set(SLANG_RHI_ENABLE_CUDA OFF CACHE BOOL "Enable CUDA backend" FORCE)
set(SLANG_RHI_ENABLE_OPTIX OFF CACHE BOOL "Enable OptiX support" FORCE)
set(SLANG_RHI_ENABLE_WGPU OFF CACHE BOOL "Enable WebGPU backend" FORCE)
set(SLANG_RHI_ENABLE_AFTERMATH OFF CACHE BOOL "Enable Aftermath support" FORCE)

set(SLANG_RHI_FETCH_SLANG OFF CACHE BOOL "Fetch slang" FORCE)
set(SLANG_RHI_FETCH_DXC OFF CACHE BOOL "Fetch DirectXShaderCompiler for the D3D12 backend" FORCE)
set(SLANG_RHI_OPTIX_VERSIONS "9_0" CACHE STRING "Enabled OptiX versions" FORCE)

set(SLANG_RHI_SLANG_INCLUDE_DIR "${_slang_inc}" CACHE PATH "Slang include directory" FORCE)
set(SLANG_RHI_SLANG_BINARY_DIR "${_slang_prefix}" CACHE PATH "Slang binary directory" FORCE)

add_subdirectory("${CMAKE_SOURCE_DIR}/external/slang-rhi")